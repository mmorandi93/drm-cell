# Backup diário do Postgres + teste de restauração.
# O arquivo é CRIPTOGRAFADO antes de virar artefato (o repositório é público).
# Secrets necessários (Settings > Secrets and variables > Actions):
#   DATABASE_URL        string de conexão do Postgres (use a URL "Session pooler"/direta do Supabase)
#   BACKUP_PASSPHRASE   senha longa e aleatória para criptografar o backup
name: backup-banco
on:
  schedule:
    - cron: "17 6 * * *"      # todo dia 06:17 UTC
  workflow_dispatch:
permissions:
  contents: read
jobs:
  backup:
    runs-on: ubuntu-latest
    services:
      teste:
        image: postgres:16
        env: { POSTGRES_PASSWORD: teste }
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres" --health-interval 5s --health-retries 10
    steps:
      - name: Instalar cliente PostgreSQL 16
        run: sudo apt-get update && sudo apt-get install -y postgresql-client-16
      - name: Backup
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
        run: pg_dump --format=custom --no-owner --file backup.dump "$DATABASE_URL"
      - name: Teste de restauração (banco descartável do runner)
        run: |
          pg_restore --no-owner -d "postgresql://postgres:teste@localhost:5432/postgres" backup.dump
          psql "postgresql://postgres:teste@localhost:5432/postgres" -c "SELECT count(*) AS calculos FROM calculos;"
      - name: Criptografar
        env:
          BACKUP_PASSPHRASE: ${{ secrets.BACKUP_PASSPHRASE }}
        run: gpg --batch --yes --symmetric --cipher-algo AES256 --passphrase "$BACKUP_PASSPHRASE" -o backup.dump.gpg backup.dump
      - uses: actions/upload-artifact@v4
        with:
          name: backup-banco
          path: backup.dump.gpg
          retention-days: 30
